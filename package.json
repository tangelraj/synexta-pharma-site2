{
  "name": "synexta-pharma-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "python \"synext_backend\\manage.py\" runserver 127.0.0.1:8000",
    "dev:client": "vite --host 0.0.0.0",
